# Variables de l'app mobile — EXPO_PUBLIC_* sont publiques (incluses dans le bundle client).
# Ne JAMAIS mettre un secret ici. Placeholders uniquement : copier en .env local et remplir.

# Projet Supabase (URL publique + clé anon publique, jamais la clé service_role).
EXPO_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE

# Base des endpoints API du site Next.js (dashboard web). En prod : URL Vercel.
# En local : http://ADRESSE-IP-DE-TON-PC:3000 (pas localhost — l'appareil est sur le réseau).
EXPO_PUBLIC_API_BASE_URL=https://VOTRE-SITE.vercel.app
