# VerifyCheck — modèle de configuration locale
# Copier ce fichier vers .env.local puis renseigner les valeurs depuis
# Supabase Dashboard > Project Settings > API.
# Ne jamais ajouter de clé service_role, secret API ou token de gestion ici.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
