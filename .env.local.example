# Copier ce fichier en .env.local et remplacer les valeurs.
# Source : Supabase Dashboard > Project Settings > API.
# Utiliser uniquement la clé publishable/anon côté navigateur.
# Ne jamais utiliser service_role ou un secret de gestion dans NEXT_PUBLIC_*.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
